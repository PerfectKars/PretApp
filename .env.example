# Valeurs fictives, développement local uniquement.
POSTGRES_DB=pretapp
POSTGRES_USER=pretapp_demo
POSTGRES_PASSWORD=local_demo_only
DATABASE_URL=postgresql+psycopg://pretapp_demo:local_demo_only@localhost:5432/pretapp
